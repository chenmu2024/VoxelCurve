---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
interface Props {
  title:string;
  description:string;
  canonical:string;
  image?:string;
  type?:'website'|'article';
  schemas?:Record<string, unknown>[];
  noindex?:boolean;
}
const {
  title,
  description,
  canonical,
  image='https://voxelcurve.com/og.png',
  type='website',
  schemas=[],
  noindex=false
} = Astro.props;
const breadcrumbs=(schemas.find(schema=>schema['@type']==='BreadcrumbList')?.itemListElement ?? []) as Array<{name:string;item:string}>;
const entity=schemas.find(schema=>schema['@type']==='SoftwareApplication'||schema['@type']==='Article');
const baseSchemas = [
  {
    '@context':'https://schema.org',
    '@type':'WebSite',
    '@id':'https://voxelcurve.com/#website',
    name:'VoxelCurve',
    url:'https://voxelcurve.com/',
    description:'Guided block-by-block geometry tools for Minecraft builders.',
    inLanguage:'en',
    publisher:{'@id':'https://voxelcurve.com/#organization'}
  },
  {
    '@context':'https://schema.org',
    '@type':'Organization',
    '@id':'https://voxelcurve.com/#organization',
    name:'VoxelCurve',
    url:'https://voxelcurve.com/',
    logo:'https://voxelcurve.com/favicon.svg',
    email:'contact@VoxelCurve.com',
    sameAs:['https://github.com/chenmu2024/VoxelCurve']
  },
  {
    '@context':'https://schema.org',
    '@type':'WebPage',
    '@id':`${canonical}#webpage`,
    url:canonical,
    name:title,
    description,
    inLanguage:'en',
    isPartOf:{'@id':'https://voxelcurve.com/#website'},
    publisher:{'@id':'https://voxelcurve.com/#organization'},
    ...(entity ? {mainEntity:{'@id':entity['@id']}} : {})
  }
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={noindex?'noindex,follow':'index,follow,max-image-preview:large'} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta name="theme-color" content="#0f1110" />
  <meta name="color-scheme" content="light" />
  <meta property="og:type" content={type} />
  <meta property="og:locale" content="en_US" />
  <meta property="og:site_name" content="VoxelCurve" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={image} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="VoxelCurve — guided Minecraft building geometry tools" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={image} />
  <meta name="twitter:image:alt" content="VoxelCurve — guided Minecraft building geometry tools" />
  {[...baseSchemas, ...schemas].map(schema => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <Header />
  <main id="main-content">
    {breadcrumbs.length>1 && <nav class="breadcrumbs container" aria-label="Breadcrumb"><ol>{breadcrumbs.map((item,index)=><li>{index===breadcrumbs.length-1?<span aria-current="page">{item.name}</span>:<a href={item.item}>{item.name}</a>}</li>)}</ol></nav>}
    <slot />
  </main>
  <Footer />
</body>
</html>
