---
interface Props { size?: number; }
const { size = 30 } = Astro.props;
---
<svg
  class="brand-mark-svg"
  width={size}
  height={size}
  viewBox="0 0 30 30"
  role="img"
  aria-label="VoxelCurve"
>
  <rect x="0.5" y="0.5" width="29" height="29" rx="7" fill="#171a18" stroke="#343834" />
  <g fill="#34d399">
    <rect x="6" y="7" width="3" height="3" rx=".45" />
    <rect x="6" y="11" width="3" height="3" rx=".45" />
    <rect x="8" y="15" width="3" height="3" rx=".45" />
    <rect x="11" y="18" width="3" height="3" rx=".45" />
    <rect x="15" y="19" width="3" height="3" rx=".45" />
    <rect x="19" y="17" width="3" height="3" rx=".45" />
    <rect x="21" y="13" width="3" height="3" rx=".45" />
    <rect x="21" y="9" width="3" height="3" rx=".45" />
  </g>
</svg>
