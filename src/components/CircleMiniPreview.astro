---
import { generateCircle } from '../core/geometry';

interface Props {
  size: number;
  label?: string;
}

const { size, label = `${size}×${size} Minecraft circle` } = Astro.props;
const result = generateCircle(size, 'thin', 1);
const cells: Array<{ x: number; y: number }> = [];

for (const row of result.rows) {
  for (const span of row.spans) {
    for (let x = span.start; x <= span.end; x++) {
      cells.push({ x, y: row.y });
    }
  }
}
---
<svg
  class="circle-mini-preview"
  viewBox={`0 0 ${size} ${size}`}
  role="img"
  aria-label={label}
  shape-rendering="crispEdges"
>
  <rect x="0" y="0" width={size} height={size} fill="white" />
  {cells.map(cell => <rect x={cell.x} y={cell.y} width="1" height="1" fill="currentColor" />)}
</svg>
