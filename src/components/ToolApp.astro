  });
  q('[data-cancel-export]').addEventListener('click',()=>cancelExport?.());
  q<HTMLButtonElement>('[data-litematic]').addEventListener('click',async()=>{
    if(exporting)return;
    let material=resolveMaterial(text('material'));
    if(!material){
      if(!confirm(`“${text('material')}” is not a supported Litematic material. Export using Stone instead? TXT and print will keep your custom label.`)){
        showStatus('Litematic export cancelled. Choose a supported material or use TXT.','neutral');return;
      }
      material='minecraft:stone';
    }
    const btn=q<HTMLButtonElement>('[data-litematic]');
    const filename=`${blueprintSlug()}.litematic`;
    const name=`VoxelCurve · ${q('[data-blueprint-title]').textContent||shape}`;
    const blueprint=params();
    let worker:Worker|null=null;
    exporting=true;btn.disabled=true;btn.textContent='Building file…';
    btn.setAttribute('aria-busy','true');
    q('[data-cancel-export]').hidden=false;
    showStatus('Generating Litematic in the background. You can keep navigating or cancel.','neutral');
    try{
      const bytes=await new Promise<Uint8Array>((resolve,reject)=>{
        worker=new LitematicWorker();
        cancelExport=()=>{worker?.terminate();reject(new Error('Litematic export cancelled.'))};
        worker.onerror=()=>reject(new Error('Litematic export could not start or ran out of memory. Try a smaller blueprint.'));
        worker.onmessage=(event:MessageEvent)=>{
          if(event.data.type==='status')showStatus(event.data.message,'neutral');
          else if(event.data.type==='ready')resolve(event.data.bytes);
          else if(event.data.type==='error')reject(new Error(event.data.message));
        };
        worker.postMessage({params:blueprint,name,material});
      });
      downloadBlob(new Blob([Uint8Array.from(bytes)],{type:'application/octet-stream'}),filename);
      usage('download_litematic');showStatus(`Litematic downloaded · ${material}.`);
    }catch(error){showStatus(error instanceof Error?error.message:'Could not create Litematic file.','neutral')}
    finally{
      (worker as Worker|null)?.terminate();cancelExport=null;exporting=false;
      btn.textContent='.litematic';btn.removeAttribute('aria-busy');
      q('[data-cancel-export]').hidden=true;renderInstruction();
    }
  });

  wrap.addEventListener('wheel',(e)=>{e.preventDefault();zoom=Math.max(.25,Math.min(8,zoom*(e.deltaY<0?1.1:.9)));draw()},{passive:false});
  wrap.addEventListener('pointerdown',(e)=>{wrap.setPointerCapture(e.pointerId);pointers.set(e.pointerId,{x:e.clientX,y:e.clientY});if(pointers.size===1)dragStart={x:e.clientX,y:e.clientY,px:panX,py:panY,moved:false};if(pointers.size===2){if(dragStart)dragStart.moved=true;const a=[...pointers.values()];pinchStart={dist:Math.hypot(a[0].x-a[1].x,a[0].y-a[1].y),zoom}}});
  wrap.addEventListener('pointermove',(e)=>{if(!pointers.has(e.pointerId))return;pointers.set(e.pointerId,{x:e.clientX,y:e.clientY});if(pointers.size===2&&pinchStart){const a=[...pointers.values()];const d=Math.hypot(a[0].x-a[1].x,a[0].y-a[1].y);zoom=Math.max(.25,Math.min(8,pinchStart.zoom*d/pinchStart.dist));draw();return}if(pointers.size===1&&dragStart){const dx=e.clientX-dragStart.x,dy=e.clientY-dragStart.y;if(Math.hypot(dx,dy)>5)dragStart.moved=true;panX=dragStart.px+dx;panY=dragStart.py+dy;draw()}});
  wrap.addEventListener('dblclick',(e)=>{e.preventDefault();fit()});
  let lastTapAt=0,lastTapX=0,lastTapY=0;
  const pointerEnd=(e:PointerEvent)=>{
    let fitted=false;
    if(e.type==='pointerup'&&e.pointerType==='touch'&&pointers.size===1&&dragStart&&!dragStart.moved){
      const now=Date.now();
      if(now-lastTapAt<340&&Math.hypot(e.clientX-lastTapX,e.clientY-lastTapY)<28){fit();lastTapAt=0;fitted=true}
      else{lastTapAt=now;lastTapX=e.clientX;lastTapY=e.clientY}
    }
    if(!fitted&&e.type==='pointerup'&&pointers.size===1&&dragStart&&!dragStart.moved){
      const rect=wrap.getBoundingClientRect();
      const gw=result.width,gh=shape==='dome'?result.depth:result.height;
      const cell=Math.max(.1,Math.min((rect.width-42)/gw,(rect.height-42)/gh))*zoom;
      const x=Math.floor((e.clientX-rect.left-(rect.width-gw*cell)/2-panX)/cell);
      const y=Math.floor((e.clientY-rect.top-(rect.height-gh*cell)/2-panY)/cell);
      const selected=(stepsByRow.get(`${currentLayer}:${y}`)||[]).find(step=>x>=step.span.start&&x<=step.span.end);
      if(selected){stepIndex=stepIndexByKey.get(selected.key)??stepIndex;saveProgress();renderInstruction()}
    }
    pointers.delete(e.pointerId);
    if(pointers.size<2)pinchStart=null;
    if(!pointers.size)dragStart=null;
    else if(dragStart)dragStart.moved=true;
  };wrap.addEventListener('pointerup',pointerEnd);wrap.addEventListener('pointercancel',pointerEnd);

  window.addEventListener('hashchange',()=>{
    if(!parseFragment())return;
    regenerate(true);
    updateFragment();
    root.scrollIntoView({block:'start',behavior:window.matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth'});
  });
  new ResizeObserver(resize).observe(wrap);
  const restoredFromFragment=parseFragment();
  regenerate(true);
  if(restoredFromFragment)updateFragment();
  resize();
}
</script>
