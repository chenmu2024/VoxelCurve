---
interface Props { shape:'circle'|'oval'|'dome'; }
const { shape } = Astro.props;
---
<section class="tool-shell container" data-tool data-shape={shape}>
  <div class="workspace-topbar">
    <div class="workspace-id"><span class="workspace-dot"></span><span>VOXELCURVE / BUILD WORKSPACE</span></div>
    <div class="workspace-meta"><span>LOCAL ENGINE</span><span>GEOMETRY V1</span></div>
  </div>
  <aside class="panel controls" aria-label="Generator controls">
    <div class="panel-heading"><p class="panel-title">01 / Controls</p><span>Shape setup</span></div>
    <button class="mobile-settings-toggle" type="button" data-settings-toggle aria-expanded="false"><span>Shape settings</span><span data-settings-icon>+</span></button>
    {shape === 'circle' && <div class="field"><label for="diameter">Diameter <small>3–512 blocks</small></label><input id="diameter" data-input="diameter" type="number" min="3" max="512" value="31" /><div class="preset-row" style="margin-top:8px">{[7,9,11,15,21,31,41,51,64,100].map(n=><button class="chip" type="button" data-preset={n}>{n}</button>)}</div></div>}
    {shape === 'oval' && <><div class="field"><label for="width">Width <small>3–512</small></label><input id="width" data-input="width" type="number" min="3" max="512" value="31" /></div><div class="field"><label for="height">Height <small>3–512</small></label><input id="height" data-input="height" type="number" min="3" max="512" value="21" /></div></>}
    {shape === 'dome' && <><div class="field"><label for="width">Width <small>3–256</small></label><input id="width" data-input="width" type="number" min="3" max="256" value="31" /></div><div class="field"><label for="depth">Depth <small>3–256</small></label><input id="depth" data-input="depth" type="number" min="3" max="256" value="31" /></div><div class="field"><label for="height">Height <small>2–256</small></label><input id="height" data-input="height" type="number" min="2" max="256" value="16" /></div></>}
    <div class="field"><label>Build style</label><input data-input="style" type="hidden" value="thin" /><div class="segment-control" role="group" aria-label="Build style"><button type="button" class="segment-option" data-style="thin" aria-pressed="true">Thin</button><button type="button" class="segment-option" data-style="thick" aria-pressed="false">Thick</button><button type="button" class="segment-option" data-style="filled" aria-pressed="false">Filled</button></div></div>
    <div class="field" data-thickness-wrap><label for="thickness">Thickness <small>blocks inward</small></label><input id="thickness" data-input="thickness" type="number" min="1" max="32" value="1" /></div>
    <div class="field"><label for="material">Material <small>optional</small></label><input id="material" data-input="material" type="text" value="Stone Bricks" maxlength="60" /></div>
    <div class="field"><label>Display</label><div class="toggle-row"><button type="button" class="toggle" data-toggle="grid" aria-pressed="true">Grid</button><button type="button" class="toggle" data-toggle="center" aria-pressed="true">Center</button><button type="button" class="toggle" data-toggle="labels" aria-pressed="true">Labels</button></div></div>
    <div class="field"><label>Instructions</label><div class="segment-control" role="group" aria-label="Instruction coordinate mode"><button type="button" class="segment-option" data-instruction-mode="center" aria-pressed="true">Center</button><button type="button" class="segment-option" data-instruction-mode="edge" aria-pressed="false">Edge</button></div></div>
    {shape === 'dome' && <button type="button" class="btn" data-hemisphere>Use hemisphere height</button>}
  </aside>

  <section class="panel canvas-panel" aria-label="Blueprint">
    <div class="canvas-toolbar"><div class="blueprint-heading"><span>02 / BLUEPRINT</span><strong data-blueprint-title>Blueprint</strong></div><div class="actions"><button class="btn" type="button" data-fit>Fit</button><button class="btn" type="button" data-zoom-out aria-label="Zoom out">−</button><button class="btn" type="button" data-zoom-in aria-label="Zoom in">+</button><button class="btn" type="button" data-print>Print</button></div></div>
    <div class="canvas-wrap" data-canvas-wrap><canvas data-canvas aria-label="Generated block blueprint">Generated block blueprint. Use the guided build instructions beside the canvas for an accessible text version.</canvas></div>
  </section>

  <aside class="panel stats">
    <div class="panel-heading"><p class="panel-title">03 / Build</p><span>Guided placement</span></div>
    <div class="stat-grid"><div class="stat"><b data-blocks>0</b><span>Blocks</span></div><div class="stat"><b data-stacks>0</b><span>Stacks + loose</span></div>{shape==='dome' && <><div class="stat"><b data-layer>1</b><span>Layer</span></div><div class="stat"><b data-layer-blocks>0</b><span>Layer blocks</span></div></>}</div>
    <div class="instruction" role="status" aria-live="polite" aria-atomic="true"><strong data-instruction-title>Generating…</strong><span data-instruction-body></span></div>
    <div class="progress" aria-label="Build progress"><i data-progress-bar></i></div><div class="notice"><span data-progress-label aria-live="polite">0% complete</span></div>
    {shape==='dome' && <div class="notice layer-progress-note" data-layer-progress>Layer 1: 0% complete</div>}
    <div class="builder-actions build-actions"><button class="btn" type="button" data-prev>← Previous</button><button class="btn accent" type="button" data-complete>Complete segment</button><button class="btn" type="button" data-next>Next →</button><button class="btn" type="button" data-undo>Undo</button></div>
    <div class="bulk-actions">
      <button class="btn" type="button" data-complete-row>Complete row</button>
      {shape==='dome' && <button class="btn" type="button" data-complete-layer>Complete layer</button>}
      <button class="btn danger-quiet" type="button" data-reset-progress>Reset progress</button>
    </div>
    <div class="nav-separator"></div>
    <div class="export-heading"><span>EXPORT</span><small>Share or save this plan</small></div>
    <div class="builder-actions export-actions"><button class="btn" type="button" data-share>Copy link</button><button class="btn" type="button" data-qr>Send to phone</button><button class="btn" type="button" data-png>PNG</button><button class="btn" type="button" data-txt>TXT plan</button><button class="btn primary" style="grid-column:1/-1" type="button" data-litematic>.litematic</button></div>
    <div class="notice">Progress is stored only in this browser. Shared links carry blueprint settings, not completion state. Litematic export falls back to Stone when a custom material label is not a recognized block.</div>
    <div class="size-warning" data-size-warning hidden></div>
    <div class="action-status" data-action-status role="status" aria-live="polite"></div>
  </aside>
  <section class="print-sheet" data-print-sheet aria-hidden="true">
    <div class="print-brand">VoxelCurve · Build Plan</div>
    <div class="print-title" data-print-sheet-title>Blueprint</div>
    <p class="print-meta" data-print-sheet-meta></p>
    <img data-print-image alt="Printable block blueprint" />
    <h2>Build instructions</h2>
    <pre data-print-plan></pre>
  </section>
  <dialog class="qr-dialog" data-qr-dialog aria-labelledby="qr-dialog-title"><button class="btn" style="float:right" data-qr-close aria-label="Close QR dialog">Close</button><h3 id="qr-dialog-title">Send blueprint to phone</h3><canvas data-qr-canvas></canvas><p class="notice">Scan to open the same dimensions on your phone.</p></dialog>
</section>

<script>
import { generateCircle, generateOval, generateDome } from '../lib/geometry';
import { buildTextPlan, rowInstruction } from '../lib/buildPlan';

const root = document.querySelector('[data-tool]');
if (root) {
  const shape = root.dataset.shape;
  const q = (s) => root.querySelector(s);
  const qa = (s) => [...root.querySelectorAll(s)];
  const canvas = q('[data-canvas]');
  const wrap = q('[data-canvas-wrap]');
  const ctx = canvas.getContext('2d');
  let result;
  let currentLayer = 0;
  let steps = [];
  let stepIndex = 0;
  let completed = new Set();
  let zoom = 1, panX = 0, panY = 0;
  let pointers = new Map(), dragStart = null, pinchStart = null;
  const display = { grid:true, center:true, labels:true };
  let instructionMode = 'center';
  const mobileControls = window.matchMedia('(max-width: 800px)');
  const settingsButton = q('[data-settings-toggle]');
  const setMobileControlsState = (collapsed) => {
    root.querySelector('.controls')?.classList.toggle('mobile-collapsed', collapsed);
    if(settingsButton){
      settingsButton.setAttribute('aria-expanded', String(!collapsed));
      const icon=settingsButton.querySelector('[data-settings-icon]');
      if(icon) icon.textContent=collapsed?'+':'−';
    }
  };
  if(mobileControls.matches) setMobileControlsState(true);


  const num = (name, fallback) => Number(q(`[data-input="${name}"]`)?.value ?? fallback);
  const text = (name, fallback='') => String(q(`[data-input="${name}"]`)?.value ?? fallback);
  const setText = (sel, value) => { const el=q(sel); if(el) el.textContent=String(value); };
  const clamp = (n,min,max) => Math.max(min, Math.min(max, Math.round(Number.isFinite(n)?n:min)));

  function params(){
    const rawStyle=text('style','thin');
    const style=['thin','thick','filled'].includes(rawStyle)?rawStyle:'thin';
    const rawThickness=clamp(num('thickness',1),1,32);
    const thickness=style==='thin'||style==='filled'?1:Math.max(2,rawThickness);
    if(shape==='circle') return {shape, diameter:clamp(num('diameter',31),3,512), style, thickness};
    if(shape==='oval') return {shape, width:clamp(num('width',31),3,512), height:clamp(num('height',21),3,512), style, thickness};
    return {shape, width:clamp(num('width',31),3,256), depth:clamp(num('depth',31),3,256), height:clamp(num('height',16),2,256), style, thickness};
  }
  function makeResult(){
    const p=params();
    if(shape==='circle') return generateCircle(p.diameter,p.style,p.thickness);
    if(shape==='oval') return generateOval(p.width,p.height,p.style,p.thickness);
    return generateDome(p.width,p.depth,p.height,p.style,p.thickness);
  }
  function stateKey(){ const p=params(); return `vc-progress-v${result.geometryVersion}-${JSON.stringify(p)}`; }
  function saveProgress(){ try{localStorage.setItem(stateKey(),JSON.stringify({completed:[...completed],stepIndex}));}catch{} }
  function loadProgress(){ completed=new Set();stepIndex=0;try{const raw=localStorage.getItem(stateKey());if(raw){const s=JSON.parse(raw);completed=new Set(s.completed||[]);stepIndex=Math.min(s.stepIndex||0,Math.max(0,steps.length-1));}}catch{} }

  function createSteps(){
    const out=[];
    if(shape==='dome'){
      result.layers.forEach((layer,li)=>layer.rows.forEach((row)=>row.spans.forEach((span,si)=>out.push({key:`L${li}R${row.y}S${si}`,layer:li,row,span,si}))));
    } else result.rows.forEach(row=>row.spans.forEach((span,si)=>out.push({key:`R${row.y}S${si}`,layer:0,row,span,si})));
    return out;
  }
  function activeRows(){ return shape==='dome' ? (result.layers[currentLayer]?.rows||[]) : result.rows; }

  function fit(){ zoom=1;panX=0;panY=0;draw(); }
  function resize(){ const r=wrap.getBoundingClientRect(); const dpr=Math.min(2,window.devicePixelRatio||1); canvas.width=Math.max(1,Math.round(r.width*dpr));canvas.height=Math.max(1,Math.round(r.height*dpr));canvas.style.width=`${r.width}px`;canvas.style.height=`${r.height}px`;ctx.setTransform(dpr,0,0,dpr,0,0);draw(); }

  function draw(){
    if(!result||!ctx) return;
    const rect=wrap.getBoundingClientRect(); const cw=rect.width,ch=rect.height;
    ctx.save();ctx.clearRect(0,0,cw,ch);ctx.fillStyle='#fcfcfc';ctx.fillRect(0,0,cw,ch);
    const rows=activeRows(); const gw=result.width; const gh=shape==='dome'?result.depth:result.height;
    const base=Math.max(2,Math.min((cw-42)/gw,(ch-42)/gh)); const cell=base*zoom;
    const ox=(cw-gw*cell)/2+panX, oy=(ch-gh*cell)/2+panY;
    const current=steps[stepIndex];
    const layerIdx=shape==='dome'?currentLayer:0;
    const activeKeys=new Map();
    steps.forEach(s=>{if(s.layer===layerIdx) activeKeys.set(`${s.row.y}:${s.si}`,s.key)});
    if(display.grid&&cell>=5){ctx.strokeStyle='#eeeeee';ctx.lineWidth=1;for(let x=0;x<=gw;x++){ctx.beginPath();ctx.moveTo(ox+x*cell,oy);ctx.lineTo(ox+x*cell,oy+gh*cell);ctx.stroke()}for(let y=0;y<=gh;y++){ctx.beginPath();ctx.moveTo(ox,oy+y*cell);ctx.lineTo(ox+gw*cell,oy+y*cell);ctx.stroke()}}
    for(const row of rows){
      row.spans.forEach((s,si)=>{
        const key=activeKeys.get(`${row.y}:${si}`); const isDone=key&&completed.has(key); const isCurrent=current&&current.layer===layerIdx&&current.row.y===row.y&&current.si===si;
        for(let x=s.start;x<=s.end;x++){
          ctx.fillStyle=isCurrent?'#171717':isDone?'#a7f3d0':'#34d399';
          ctx.fillRect(ox+x*cell+Math.min(1,cell*.08),oy+row.y*cell+Math.min(1,cell*.08),Math.max(1,cell-Math.min(2,cell*.16)),Math.max(1,cell-Math.min(2,cell*.16)));
        }
      })
    }
    if(display.center){ctx.strokeStyle='#f59e0b';ctx.lineWidth=1.5;ctx.setLineDash([5,5]);ctx.beginPath();ctx.moveTo(ox+gw*cell/2,oy);ctx.lineTo(ox+gw*cell/2,oy+gh*cell);ctx.moveTo(ox,oy+gh*cell/2);ctx.lineTo(ox+gw*cell,oy+gh*cell/2);ctx.stroke();ctx.setLineDash([])}
    if(display.labels&&cell>=13){ctx.fillStyle='#65766c';ctx.font='10px system-ui';ctx.textAlign='right';ctx.textBaseline='middle';for(const row of rows){if(row.count)ctx.fillText(String(row.y+1),ox-5,oy+(row.y+.5)*cell)}}
    ctx.restore();
  }

  function renderInstruction(){
    if(!steps.length){setText('[data-instruction-title]','No blocks generated');setText('[data-instruction-body]','Try a different size.');return;}
    stepIndex=Math.max(0,Math.min(stepIndex,steps.length-1)); const s=steps[stepIndex]; currentLayer=s.layer;
    const inst=rowInstruction(s.row,result.width)[s.si];
    const title=shape==='dome'?`Layer ${s.layer+1} · Row ${s.row.y+1} · Segment ${s.si+1}`:`Row ${s.row.y+1} · Segment ${s.si+1}`;
    const gap= s.si<s.row.spans.length-1 ? s.row.spans[s.si+1].start-s.span.end-1 : 0;
    const primary=instructionMode==='edge'?inst.edge:inst.center;
    const body=`${primary}. ${gap>0?`Then skip ${gap} block${gap===1?'':'s'}.`:''}`;
    setText('[data-instruction-title]',title);setText('[data-instruction-body]',body);
    const done=completed.size; const pct=steps.length?Math.round(done/steps.length*100):0; q('[data-progress-bar]').style.width=`${pct}%`;setText('[data-progress-label]',`${pct}% complete · ${done}/${steps.length} segments`);
    if(shape==='dome'){
      setText('[data-layer]',`${currentLayer+1}/${result.layers.length}`);
      setText('[data-layer-blocks]',result.layers[currentLayer]?.count||0);
      const layerSteps=steps.filter(step=>step.layer===currentLayer);
      const layerDone=layerSteps.filter(step=>completed.has(step.key)).length;
      const layerPct=layerSteps.length?Math.round(layerDone/layerSteps.length*100):0;
      setText('[data-layer-progress]',`Layer ${currentLayer+1}: ${layerPct}% · ${layerDone}/${layerSteps.length} segments`);
    }
    const volume=result.type==='dome'?result.width*result.depth*result.height:result.width*result.height;
    const blocked=volume>20_000_000||result.blockCount>5_000_000;
    const large=volume>10_000_000||result.blockCount>2_000_000;
    const litematic=q('[data-litematic]');
    if(litematic){
      litematic.disabled=blocked;
      litematic.title=blocked?'Reduce dimensions before exporting Litematic.':'Download Litematic for supported Java Edition workflows.';
    }
    const warning=q('[data-size-warning]');
    if(warning){
      warning.hidden=!large;
      warning.textContent=blocked
        ? 'This structure is too large for safe browser Litematic export. Reduce its dimensions or use a hollow build.'
        : 'Large structure: exports may take longer on mobile devices.';
    }
    q('[data-complete]').textContent=completed.has(s.key)?'Completed ✓':'Complete segment';
    draw();
  }

  function renderStats(){setText('[data-blocks]',result.blockCount.toLocaleString()); const stacks=Math.floor(result.blockCount/64),loose=result.blockCount%64;setText('[data-stacks]',loose?`${stacks} + ${loose}`:String(stacks)); const p=params();setText('[data-blueprint-title]',shape==='circle'?`${p.diameter}×${p.diameter} Circle`:shape==='oval'?`${p.width}×${p.height} Oval`:`${p.width}×${p.depth}×${p.height} Dome`)}

  function normalizeInputs(){
    const styleInput=q('[data-input="style"]');
    const thicknessInput=q('[data-input="thickness"]');
    if(styleInput) styleInput.value=result.style;
    if(thicknessInput) thicknessInput.value=String(result.thickness);
    if(shape==='circle'){
      const input=q('[data-input="diameter"]'); if(input) input.value=String(result.width);
    } else if(shape==='oval'){
      const w=q('[data-input="width"]'); const h=q('[data-input="height"]');
      if(w) w.value=String(result.width); if(h) h.value=String(result.height);
    } else {
      const w=q('[data-input="width"]'); const d=q('[data-input="depth"]'); const h=q('[data-input="height"]');
      if(w) w.value=String(result.width); if(d) d.value=String(result.depth); if(h) h.value=String(result.height);
    }
  }

  function regenerate(resetView=false){
    result=makeResult();normalizeInputs();steps=createSteps();loadProgress();if(resetView){zoom=1;panX=0;panY=0}renderStats();renderInstruction();
    q('[data-thickness-wrap]').style.display=result.style==='thick'?'':'none';
    qa('[data-style]').forEach(el=>el.setAttribute('aria-pressed',String(el.dataset.style===text('style'))));
    if(shape==='circle'){
      const d=String(params().diameter);
      qa('[data-preset]').forEach(el=>el.setAttribute('aria-pressed',String(el.dataset.preset===d)));
    }
  }

  function updateFragment(){ const p=params(); let v=''; if(shape==='circle')v=`c-${p.diameter}-${p.style}-${p.thickness}`; if(shape==='oval')v=`o-${p.width}-${p.height}-${p.style}-${p.thickness}`; if(shape==='dome')v=`d-${p.width}-${p.depth}-${p.height}-${p.style}-${p.thickness}`;history.replaceState(null,'',`${location.pathname}#${v}`);return `https://voxelcurve.com${location.pathname}#${v}`; }
  function parseFragment(){const h=location.hash.slice(1).split('-');if(!h.length)return;try{if(shape==='circle'&&h[0]==='c'){q('[data-input="diameter"]').value=h[1];q('[data-input="style"]').value=h[2];q('[data-input="thickness"]').value=h[3];}if(shape==='oval'&&h[0]==='o'){q('[data-input="width"]').value=h[1];q('[data-input="height"]').value=h[2];q('[data-input="style"]').value=h[3];q('[data-input="thickness"]').value=h[4];}if(shape==='dome'&&h[0]==='d'){q('[data-input="width"]').value=h[1];q('[data-input="depth"]').value=h[2];q('[data-input="height"]').value=h[3];q('[data-input="style"]').value=h[4];q('[data-input="thickness"]').value=h[5];}}catch{}}

  let statusTimer=0;
  function showStatus(message,kind='ok'){
    const el=q('[data-action-status]'); if(!el)return;
    el.textContent=message;
    el.dataset.kind=kind;
    clearTimeout(statusTimer);
    statusTimer=window.setTimeout(()=>{el.textContent='';delete el.dataset.kind},2600);
  }

  function downloadBlob(blob,filename){
    const a=document.createElement('a');
    const url=URL.createObjectURL(blob);
    a.href=url;a.download=filename;document.body.appendChild(a);a.click();a.remove();
    setTimeout(()=>URL.revokeObjectURL(url),1500);
  }

  function createPngExportCanvas(){
    const rows=activeRows();
    const gw=result.width;
    const gh=shape==='dome'?result.depth:result.height;
    const padding=display.labels?44:24;
    const maxSide=2048;
    const targetCell=Math.max(3,Math.min(24,Math.floor((maxSide-padding*2)/Math.max(gw,gh))));
    const width=gw*targetCell+padding*2;
    const height=gh*targetCell+padding*2;
    const out=document.createElement('canvas');
    out.width=width;
    out.height=height;
    const x=out.getContext('2d');
    x.fillStyle='#ffffff';
    x.fillRect(0,0,width,height);

    if(display.grid&&targetCell>=5){
      x.strokeStyle='#eeeeee';
      x.lineWidth=1;
      for(let gx=0;gx<=gw;gx++){
        x.beginPath();x.moveTo(padding+gx*targetCell,padding);x.lineTo(padding+gx*targetCell,padding+gh*targetCell);x.stroke();
      }
      for(let gy=0;gy<=gh;gy++){
        x.beginPath();x.moveTo(padding,padding+gy*targetCell);x.lineTo(padding+gw*targetCell,padding+gy*targetCell);x.stroke();
      }
    }

    x.fillStyle='#34d399';
    for(const row of rows){
      for(const span of row.spans){
        for(let bx=span.start;bx<=span.end;bx++){
          const inset=Math.min(1,targetCell*.08);
          x.fillRect(
            padding+bx*targetCell+inset,
            padding+row.y*targetCell+inset,
            Math.max(1,targetCell-inset*2),
            Math.max(1,targetCell-inset*2)
          );
        }
      }
    }

    if(display.center){
      x.strokeStyle='#f59e0b';
      x.lineWidth=1;
      x.setLineDash([5,5]);
      x.beginPath();
      x.moveTo(padding+gw*targetCell/2,padding);
      x.lineTo(padding+gw*targetCell/2,padding+gh*targetCell);
      x.moveTo(padding,padding+gh*targetCell/2);
      x.lineTo(padding+gw*targetCell,padding+gh*targetCell/2);
      x.stroke();
      x.setLineDash([]);
    }

    if(display.labels&&targetCell>=10){
      x.fillStyle='#737373';
      x.font='11px ui-monospace, SFMono-Regular, Menlo, monospace';
      x.textAlign='right';
      x.textBaseline='middle';
      for(const row of rows){
        if(row.count)x.fillText(String(row.y+1),padding-7,padding+(row.y+.5)*targetCell);
      }
    }

    return out;
  }

  settingsButton?.addEventListener('click',()=>setMobileControlsState(!root.querySelector('.controls')?.classList.contains('mobile-collapsed')));
  mobileControls.addEventListener?.('change',(event)=>setMobileControlsState(event.matches));
    qa('[data-input]').filter(el=>el.getAttribute('type')!=='hidden').forEach(el=>el.addEventListener(el.tagName==='SELECT'?'change':'input',()=>regenerate(true)));
  qa('[data-style]').forEach(el=>el.addEventListener('click',()=>{
    const style=el.dataset.style;
    q('[data-input="style"]').value=style;
    const thickness=q('[data-input="thickness"]');
    if(thickness){
      if(style==='thin'||style==='filled') thickness.value='1';
      if(style==='thick'&&Number(thickness.value)<2) thickness.value='2';
    }
    regenerate(false);
  }));
  qa('[data-preset]').forEach(el=>el.addEventListener('click',()=>{q('[data-input="diameter"]').value=el.dataset.preset;regenerate(true)}));
  qa('[data-toggle]').forEach(el=>el.addEventListener('click',()=>{const k=el.dataset.toggle;display[k]=!display[k];el.setAttribute('aria-pressed',String(display[k]));draw()}));
  qa('[data-instruction-mode]').forEach(el=>el.addEventListener('click',()=>{instructionMode=el.dataset.instructionMode;qa('[data-instruction-mode]').forEach(btn=>btn.setAttribute('aria-pressed',String(btn===el)));renderInstruction()}));
  q('[data-hemisphere]')?.addEventListener('click',()=>{const w=num('width',31);q('[data-input="depth"]').value=String(w);q('[data-input="height"]').value=String(Math.ceil(w/2));regenerate(true)});
  q('[data-fit]').addEventListener('click',fit);
  q('[data-zoom-in]').addEventListener('click',()=>{zoom=Math.min(8,zoom*1.2);draw()});
  q('[data-zoom-out]').addEventListener('click',()=>{zoom=Math.max(.25,zoom/1.2);draw()});
  q('[data-print]').addEventListener('click',()=>{
    const exportCanvas=createPngExportCanvas();
    const printImage=q('[data-print-image]');
    if(printImage) printImage.src=exportCanvas.toDataURL('image/png');
    setText('[data-print-sheet-title]',q('[data-blueprint-title]')?.textContent||'VoxelCurve Blueprint');
    const stacks=Math.floor(result.blockCount/64),loose=result.blockCount%64;
    setText('[data-print-sheet-meta]',`${result.blockCount.toLocaleString()} blocks · ${stacks} stack${stacks===1?'':'s'}${loose?` + ${loose} blocks`:''} · ${text('material','Blocks')}`);
    const plan=q('[data-print-plan]'); if(plan) plan.textContent=buildTextPlan(result,text('material','Blocks'));
    document.body.classList.add('vc-printing');
    requestAnimationFrame(()=>window.print());
  });
  window.addEventListener('afterprint',()=>document.body.classList.remove('vc-printing'));
  q('[data-prev]').addEventListener('click',()=>{stepIndex=Math.max(0,stepIndex-1);saveProgress();renderInstruction()});
  q('[data-next]').addEventListener('click',()=>{stepIndex=Math.min(steps.length-1,stepIndex+1);saveProgress();renderInstruction()});
  q('[data-complete]').addEventListener('click',()=>{const s=steps[stepIndex];if(!s)return;if(completed.has(s.key))completed.delete(s.key);else{completed.add(s.key);if(stepIndex<steps.length-1)stepIndex++}saveProgress();renderInstruction()});
  q('[data-undo]').addEventListener('click',()=>{if(!completed.size)return;const arr=[...completed];const key=arr[arr.length-1];completed.delete(key);const idx=steps.findIndex(s=>s.key===key);if(idx>=0)stepIndex=idx;saveProgress();renderInstruction()});
  q('[data-complete-row]').addEventListener('click',()=>{
    const current=steps[stepIndex]; if(!current)return;
    const rowSteps=steps.filter(step=>step.layer===current.layer&&step.row.y===current.row.y);
    rowSteps.forEach(step=>completed.add(step.key));
    const next=steps.findIndex((step,index)=>index>stepIndex&&(step.layer!==current.layer||step.row.y!==current.row.y));
    if(next>=0) stepIndex=next; else stepIndex=steps.length-1;
    saveProgress();renderInstruction();
  });
  q('[data-complete-layer]')?.addEventListener('click',()=>{
    const current=steps[stepIndex]; if(!current)return;
    steps.filter(step=>step.layer===current.layer).forEach(step=>completed.add(step.key));
    const next=steps.findIndex((step,index)=>index>stepIndex&&step.layer!==current.layer);
    if(next>=0) stepIndex=next; else stepIndex=steps.length-1;
    saveProgress();renderInstruction();
  });
  q('[data-reset-progress]').addEventListener('click',()=>{
    if(!completed.size&&stepIndex===0)return;
    if(!confirm('Reset all saved progress for this blueprint?'))return;
    completed.clear();stepIndex=0;saveProgress();renderInstruction();
  });
  q('[data-share]').addEventListener('click',async()=>{
    const url=updateFragment();
    try{
      await navigator.clipboard.writeText(url);
      showStatus('Canonical blueprint link copied.');
    }catch{
      const value=prompt('Copy this blueprint link:',url);
      showStatus(value===null?'Copy cancelled.':'Blueprint link ready.','neutral');
    }
  });
  q('[data-qr]').addEventListener('click',async()=>{
    const btn=q('[data-qr]');const old=btn.textContent;btn.disabled=true;btn.textContent='Creating…';
    try{
      const url=updateFragment();
      const QRCode=(await import('qrcode')).default;
      const qc=q('[data-qr-canvas]');
      await QRCode.toCanvas(qc,url,{width:240,margin:1});
      q('[data-qr-dialog]').showModal();
      showStatus('QR code created for voxelcurve.com.');
    }catch{
      showStatus('Could not create QR code. Try Copy link instead.','error');
    }finally{btn.disabled=false;btn.textContent=old}
  });
  q('[data-qr-close]').addEventListener('click',()=>q('[data-qr-dialog]').close());
  q('[data-png]').addEventListener('click',()=>{
    try{
      const exportCanvas=createPngExportCanvas();
      const suffix=shape==='dome'?'-layer-'+(currentLayer+1):'';
      exportCanvas.toBlob(blob=>{
        if(!blob){showStatus('Could not create PNG.','error');return}
        downloadBlob(blob,`voxelcurve-${shape}${suffix}.png`);
        showStatus('PNG blueprint downloaded.');
      },'image/png');
    }catch{showStatus('Could not create PNG.','error')}
  });
  q('[data-txt]').addEventListener('click',()=>{
    try{
      const blob=new Blob([buildTextPlan(result,text('material','Blocks'))],{type:'text/plain;charset=utf-8'});
      downloadBlob(blob,`voxelcurve-${shape}-build-plan.txt`);
      showStatus('TXT build plan downloaded.');
    }catch{showStatus('Could not create TXT plan.','error')}
  });
  q('[data-litematic]').addEventListener('click',async()=>{const btn=q('[data-litematic]');const old=btn.textContent;btn.textContent='Building file…';btn.disabled=true;try{const {exportLitematic}=await import('../lib/litematic');const raw=text('material','stone').trim().toLowerCase();const aliases={'stone bricks':'stone_bricks','stone brick':'stone_bricks','glass':'glass','quartz':'quartz_block','quartz block':'quartz_block','stone':'stone','cobblestone':'cobblestone','deepslate':'deepslate','smooth stone':'smooth_stone','oak planks':'oak_planks','spruce planks':'spruce_planks','birch planks':'birch_planks','white concrete':'white_concrete','black concrete':'black_concrete','gray concrete':'gray_concrete','light gray concrete':'light_gray_concrete'};const allowed=new Set(['stone','stone_bricks','glass','quartz_block','cobblestone','deepslate','smooth_stone','oak_planks','spruce_planks','birch_planks','white_concrete','black_concrete','gray_concrete','light_gray_concrete']);const normalized=raw.replace(/[^a-z0-9_]/g,'_');const candidate=aliases[raw]||(allowed.has(normalized)?normalized:'');const safe=candidate||'stone';const bytes=exportLitematic(result,`VoxelCurve ${shape}`,`minecraft:${safe||'stone'}`);const blob=new Blob([bytes],{type:'application/octet-stream'});downloadBlob(blob,`voxelcurve-${shape}.litematic`);showStatus('Litematic file downloaded.')}catch(e){showStatus(e?.message||'Could not create Litematic file.','error')}finally{btn.textContent=old;btn.disabled=false}});

  wrap.addEventListener('wheel',(e)=>{e.preventDefault();zoom=Math.max(.25,Math.min(8,zoom*(e.deltaY<0?1.1:.9)));draw()},{passive:false});
  wrap.addEventListener('pointerdown',(e)=>{wrap.setPointerCapture(e.pointerId);pointers.set(e.pointerId,{x:e.clientX,y:e.clientY});if(pointers.size===1)dragStart={x:e.clientX,y:e.clientY,px:panX,py:panY,moved:false};if(pointers.size===2){const a=[...pointers.values()];pinchStart={dist:Math.hypot(a[0].x-a[1].x,a[0].y-a[1].y),zoom}}});
  wrap.addEventListener('pointermove',(e)=>{if(!pointers.has(e.pointerId))return;pointers.set(e.pointerId,{x:e.clientX,y:e.clientY});if(pointers.size===2&&pinchStart){const a=[...pointers.values()];const d=Math.hypot(a[0].x-a[1].x,a[0].y-a[1].y);zoom=Math.max(.25,Math.min(8,pinchStart.zoom*d/pinchStart.dist));draw();return}if(pointers.size===1&&dragStart){const dx=e.clientX-dragStart.x,dy=e.clientY-dragStart.y;if(Math.hypot(dx,dy)>5)dragStart.moved=true;panX=dragStart.px+dx;panY=dragStart.py+dy;draw()}});
  const pointerEnd=(e)=>{pointers.delete(e.pointerId);if(pointers.size<2)pinchStart=null;if(!pointers.size)dragStart=null};wrap.addEventListener('pointerup',pointerEnd);wrap.addEventListener('pointercancel',pointerEnd);

  new ResizeObserver(resize).observe(wrap);parseFragment();regenerate(true);resize();
}
</script>
