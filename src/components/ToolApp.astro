  }

  function regenerate(resetView=false){
    undoHistory=[];
    completed=new Set();stepIndex=0;
    result=makeResult();normalizeInputs();steps=createSteps();indexSteps();loadProgress();if(resetView){zoom=1;panX=0;panY=0}renderStats();renderInstruction();
    q('[data-thickness-wrap]').style.display=result.style==='thick'?'':'none';
