    const rowSteps=stepsByRow.get(`${currentLayer}:${target-1}`)||[];
    const chosen=rowSteps.find(step=>!completed.has(step.key))||rowSteps[0];
    if(!chosen){showStatus(`Row ${target} has no blocks on this layer.`,'neutral');renderInstruction();return}
    stepIndex=stepIndexByKey.get(chosen.key)??stepIndex;saveProgress();renderInstruction();
  });
