  function goToLayer(target:number){
    if(shape!=='dome')return;
    target=Math.max(0,Math.min(result.layers.length-1,target));
    const layerSteps=stepsByLayer.get(target)||[];
    const chosen=layerSteps.find(step=>!completed.has(step.key))||layerSteps[0];
    if(chosen){
      stepIndex=stepIndexByKey.get(chosen.key)??0;
      saveProgress();renderInstruction();
    }
  }
  function goToRow(direction:number){
    const current=steps[stepIndex];if(!current)return;
    const layerSteps=stepsByLayer.get(current.layer)||[];
    const chosen=direction>0?layerSteps.find(step=>step.row.y>current.row.y):layerSteps.findLast(step=>step.row.y<current.row.y);
    if(chosen){
      const first=(stepsByRow.get(`${chosen.layer}:${chosen.row.y}`)||[])[0];
      stepIndex=stepIndexByKey.get(first.key)??stepIndex;saveProgress();renderInstruction();
    }
  }
