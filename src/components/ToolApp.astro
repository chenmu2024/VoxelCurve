---
import { GEOMETRY_VERSION, generateCircle, generateOval, generateDome } from '../core/geometry';
import { spanInstruction } from '../lib/buildPlan';
import { materials } from '../lib/materials';
interface Props { shape:'circle'|'oval'|'dome'; }
const { shape } = Astro.props;
const initial = shape==='circle'?generateCircle(31):shape==='oval'?generateOval(31,21):generateDome(31,31,16);
const initialRows = shape==='dome'?initial.layers[0].rows:initial.rows;
const firstRow = initialRows.find(row=>row.count)!;
const firstInstruction = spanInstruction(firstRow.spans[0],initial.width).center;
const initialTitle = shape==='circle'?'31×31 Circle':shape==='oval'?'31×21 Oval':'31×31×16 Dome';
---
<section class="tool-shell container" data-tool data-shape={shape}>
  <div class="workspace-topbar">
    <div class="workspace-id"><span class="workspace-dot"></span><span>VOXELCURVE / BUILD WORKSPACE</span></div>
    <div class="workspace-meta"><span>LOCAL ENGINE</span><span>GEOMETRY V{GEOMETRY_VERSION}</span><button class="workspace-build-toggle" type="button" data-build-mode aria-pressed="false">Build mode</button></div>
  </div>
  <aside class="panel controls mobile-collapsed" aria-label="Generator controls">
    <div class="panel-heading"><p class="panel-title">01 / Controls</p><span>Shape setup</span></div>
    <button class="mobile-settings-toggle" type="button" data-settings-toggle aria-expanded="false"><span>Shape settings</span><span data-settings-icon>+</span></button>
    {shape === 'circle' && <div class="field"><label for="diameter">Diameter <small>3–512 blocks</small></label><input id="diameter" data-input="diameter" type="number" min="3" max="512" value="31" /><div class="preset-row" style="margin-top:8px">{[7,9,11,15,21,31,41,51,64,100].map(n=><button class="chip" type="button" data-preset={n}>{n}</button>)}</div></div>}
    {shape === 'oval' && <><div class="field"><label for="width">Width <small>3–512</small></label><input id="width" data-input="width" type="number" min="3" max="512" value="31" /></div><div class="field"><label for="height">Height <small>3–512</small></label><input id="height" data-input="height" type="number" min="3" max="512" value="21" /></div></>}
    {shape === 'dome' && <><div class="field"><label for="width">Width <small>3–256</small></label><input id="width" data-input="width" type="number" min="3" max="256" value="31" /></div><div class="field"><label for="depth">Depth <small>3–256</small></label><input id="depth" data-input="depth" type="number" min="3" max="256" value="31" /></div><div class="field"><label for="height">Height <small>2–256</small></label><input id="height" data-input="height" type="number" min="2" max="256" value="16" /></div></>}
    <div class="field"><label>Build style</label><input data-input="style" type="hidden" value="thin" /><div class="segment-control" role="group" aria-label="Build style"><button type="button" class="segment-option" data-style="thin" aria-pressed="true">Thin</button><button type="button" class="segment-option" data-style="thick" aria-pressed="false">Thick</button><button type="button" class="segment-option" data-style="filled" aria-pressed="false">Filled</button></div></div>
    <div class="field" data-thickness-wrap style="display:none"><label for="thickness">Thickness <small>blocks inward</small></label><input id="thickness" data-input="thickness" type="number" min="1" max="32" value="1" /></div>
    <div class="field"><label for="material">Material <small>choose or type</small></label><input id="material" data-input="material" type="text" value="Stone Bricks" maxlength="60" list="materials" aria-describedby="material-export-note" /><datalist id="materials">{materials.map(([name])=><option value={name} />)}</datalist><p class="notice" id="material-export-note" data-material-note>Litematic material: minecraft:stone_bricks.</p></div>
    <div class="field"><label>Display</label><div class="toggle-row"><button type="button" class="toggle" data-toggle="grid" aria-pressed="true">Grid</button><button type="button" class="toggle" data-toggle="center" aria-pressed="true">Center</button><button type="button" class="toggle" data-toggle="labels" aria-pressed="true">Row numbers</button><button type="button" class="toggle" data-toggle="axis" aria-pressed="true">Axis</button><button type="button" class="toggle" data-toggle="segments" aria-pressed="true">Segment labels</button>{shape==='dome' && <button type="button" class="toggle" data-toggle="ghost" aria-pressed="true">Ghost layer</button>}</div></div>
    <div class="field"><label>Instructions</label><div class="segment-control" role="group" aria-label="Instruction coordinate mode"><button type="button" class="segment-option" data-instruction-mode="center" aria-pressed="true">Center</button><button type="button" class="segment-option" data-instruction-mode="edge" aria-pressed="false">Edge</button></div></div>
    {shape === 'dome' && <button type="button" class="btn" data-hemisphere>Use hemisphere height</button>}
  </aside>

  <section class="panel canvas-panel" aria-label="Blueprint">
    <div class="canvas-toolbar"><div class="blueprint-heading"><span>02 / BLUEPRINT</span><strong data-blueprint-title>{initialTitle}</strong></div><div class="actions"><button class="btn" type="button" data-fit>Fit</button><button class="btn" type="button" data-zoom-out aria-label="Zoom out">−</button><button class="btn" type="button" data-zoom-in aria-label="Zoom in">+</button><button class="btn" type="button" data-print>Print</button></div></div>
    <div class="canvas-wrap" data-canvas-wrap><canvas data-canvas aria-label="Generated block blueprint">Generated block blueprint. Use the guided build instructions beside the canvas for an accessible text version.</canvas></div>
  </section>

  <aside class="panel stats">
    <div class="panel-heading"><p class="panel-title">03 / Build</p><span>Guided placement</span></div>
    <div class="stat-grid"><div class="stat"><b data-blocks>{initial.blockCount.toLocaleString('en-US')}</b><span>Blocks</span></div><div class="stat"><b data-stacks>{Math.floor(initial.blockCount/64)} + {initial.blockCount%64}</b><span>Stacks + loose</span></div>{shape==='dome' && <><div class="stat"><b data-layer>1/{initial.layers.length}</b><span>Layer</span></div><div class="stat"><b data-layer-blocks>{initial.layers[0].count}</b><span>Layer blocks</span></div></>}</div>
    <div class="instruction" role="status" aria-live="polite" aria-atomic="true"><strong data-instruction-title>{shape==='dome'?'Layer 1 / 16 · ':''}Row {firstRow.y+1} / {initialRows.length} · Segment 1 / {firstRow.spans.length}</strong><span data-instruction-body>{firstInstruction}.</span></div>
    <div class="progress" role="progressbar" aria-label="Build progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><i data-progress-bar></i></div><div class="notice progress-note"><span data-progress-label aria-live="polite">0% complete</span></div>
    <div class="notice progress-note" data-remaining>Materials remaining</div>
    <div class="notice progress-note" data-save-status role="status" aria-live="polite">Checking local progress storage…</div>
    {shape==='dome' && <>
      <div class="notice layer-progress-note" data-layer-progress>Layer 1: 0% complete</div>
      <div class="notice layer-delta-note" data-layer-delta>Base layer</div>
      <div class="layer-nav"><button class="btn" type="button" data-layer-prev>← Previous layer</button><button class="btn" type="button" data-layer-next>Next layer →</button></div>
      <label class="layer-jump">Go to layer <input type="number" min="1" value="1" data-layer-jump-input inputmode="numeric" /> <span>/ <span data-layer-total>1</span></span></label>
    </>}
    <div class="builder-actions build-actions"><button class="btn" type="button" data-prev>← Previous segment</button>{shape==='dome'?<button class="btn accent" type="button" data-complete-row>Complete row</button>:<button class="btn accent" type="button" data-complete>Complete segment</button>}<button class="btn" type="button" data-next>Next segment →</button><button class="btn" type="button" data-undo>Undo</button></div>
    <div class="layer-nav"><button class="btn" type="button" data-row-prev>← Previous row</button><button class="btn" type="button" data-row-next>Next row →</button></div>
    <label class="layer-jump">Go to row <input type="number" min="1" value="1" data-row-jump-input inputmode="numeric" /> <span>/ <span data-row-total>{initialRows.length}</span></span></label>
    <button class="btn next-unfinished" type="button" data-unfinished>Next unfinished segment</button>
    <div class="bulk-actions">
      {shape==='dome'?<button class="btn" type="button" data-complete>Complete segment</button>:<button class="btn" type="button" data-complete-row>Complete row</button>}
      {shape==='dome' && <button class="btn" type="button" data-complete-layer>Complete layer</button>}
      <button class="btn danger-quiet" type="button" data-reset-progress>Reset progress</button>
    </div>
    <div class="nav-separator"></div>
    <div class="export-heading"><span>EXPORT</span><small>Share or save this plan</small></div>
    <div class="field png-options"><label for="png-options">PNG layout</label><select id="png-options" data-png-options><option value="plain">Blueprint only</option><option value="grid">Blueprint + grid</option><option value="rows" selected>Blueprint + row numbers</option></select></div>
    <div class="builder-actions export-actions"><button class="btn" type="button" data-share>Copy link</button><button class="btn" type="button" data-qr>Send to phone</button><button class="btn" type="button" data-png>PNG</button><button class="btn" type="button" data-txt>TXT plan</button><button class="btn primary" type="button" data-litematic>.litematic</button></div>
    <button class="btn" type="button" data-cancel-export hidden>Cancel Litematic export</button>
    <details class="export-help"><summary>How to use the Litematic file</summary><ol><li>Use Minecraft Java with a compatible Litematica installation. The file uses V6 / Java 1.20.4 data; Bedrock cannot import it directly.</li><li>Put the downloaded file in your Minecraft instance's <code>schematics</code> folder.</li><li>Open Litematica's menu (default: M), choose Load Schematics and create a placement.</li><li>Compare the material list and block count with this blueprint before building. The file's origin is (0, 0, 0); blueprint right is +X, rows run along +Z and dome layers rise along +Y. Move the placement to your build site.</li></ol><p class="notice">Automated file checks pass. In-game compatibility still needs a real import test for your installed versions. <a href="https://github.com/maruohon/litematica/wiki/Basic-Operations" target="_blank" rel="noopener noreferrer">Litematica instructions →</a></p></details>
    <div class="notice">Progress is stored only in this browser. Shared links carry blueprint settings, not completion state. Custom material labels remain in TXT and print plans; unknown Litematic materials require confirmation before using Stone.</div>
    <div class="size-warning" data-size-warning hidden></div>
    <div class="action-status" data-action-status role="status" aria-live="polite"></div>
  </aside>
  <section class="print-sheet" data-print-sheet aria-hidden="true">
    <div class="print-brand">VoxelCurve · Build Plan</div>
    <div class="print-title" data-print-sheet-title>Blueprint</div>
    <p class="print-meta" data-print-sheet-meta></p>
    <img data-print-image alt="Printable block blueprint" />
    <h2>Build instructions</h2>
    <pre data-print-plan></pre>
  </section>
  <dialog class="qr-dialog" data-qr-dialog aria-labelledby="qr-dialog-title"><button class="btn" style="float:right" data-qr-close aria-label="Close QR dialog">Close</button><h3 id="qr-dialog-title">Send blueprint to phone</h3><canvas data-qr-canvas role="img" aria-label="QR code for this blueprint"></canvas><p class="notice">Scan to open the same dimensions on your phone. Build progress stays on this device.</p><p class="qr-link-row"><a class="text-link" data-qr-link href="/" rel="noopener">Open blueprint link →</a></p></dialog>
</section>

<script>
import type { ShapeResult, RowPlan, Span, ShapeType, BuildStyle } from '../core/geometry';
import type { BlueprintState } from '../lib/state';
import { generateCircle, generateOval, generateDome } from '../core/geometry';
import { buildTextPlan, rowInstruction } from '../lib/buildPlan';
import { canonicalBlueprintUrl, parseBlueprintFragment, serializeBlueprintState } from '../lib/state';
import { decodeProgress, encodeProgress } from '../lib/progress';
import { resolveMaterial } from '../lib/materials';
import LitematicWorker from '../lib/litematic.worker?worker';

const root = document.querySelector<HTMLElement>('[data-tool]');
if (root) {
  const shape = root.dataset.shape as ShapeType;
  interface Step { key:string; layer:number; row:RowPlan; span:Span; si:number; }
  const q = <T extends HTMLElement = HTMLElement>(selector:string):T => {
    const element=root.querySelector<T>(selector);
    if(!element)throw new Error(`Missing tool element: ${selector}`);
    return element;
  };
  const qa = <T extends HTMLElement = HTMLButtonElement>(selector:string) => [...root.querySelectorAll<T>(selector)];
  const canvas = q<HTMLCanvasElement>('[data-canvas]');
  const wrap = q('[data-canvas-wrap]');
  const ctx = canvas.getContext('2d')!;
  let result:ShapeResult;
  let currentLayer = 0;
  let steps:Step[] = [];
  let stepsByLayer = new Map<number,Step[]>();
  let stepsByRow = new Map<string,Step[]>();
  let stepKeysByLayer = new Map<number,Map<string,string>>();
  let stepIndexByKey = new Map<string,number>();
  let stepIndex = 0;
  let completed = new Set<string>();
  let undoHistory:{added:string[];removed:string[];stepIndex:number}[] = [];
  let zoom = 1, panX = 0, panY = 0;
  const pointers = new Map<number,{x:number;y:number}>();
  let dragStart:{x:number;y:number;px:number;py:number;moved:boolean}|null = null;
  let pinchStart:{dist:number;zoom:number}|null = null;
  const display = { grid:true, center:true, axis:true, labels:true, segments:true, ghost:true };
  let instructionMode = 'center';
  let buildMode = false;
  let buildModeScrollY = 0;
  let exporting=false;
  let cancelExport:(()=>void)|null=null;
  function usage(name:string){
    window.dispatchEvent(new CustomEvent('voxelcurve:usage',{detail:{name,shape}}));
  }
  const mobileControls = window.matchMedia('(max-width: 800px)');
  const settingsButton = q('[data-settings-toggle]');
  const setMobileControlsState = (collapsed:boolean) => {
    root.querySelector('.controls')?.classList.toggle('mobile-collapsed', collapsed);
    if(settingsButton){
      settingsButton.setAttribute('aria-expanded', String(!collapsed));
      const icon=settingsButton.querySelector('[data-settings-icon]');
      if(icon) icon.textContent=collapsed?'+':'−';
    }
  };
  if(mobileControls.matches) setMobileControlsState(true);

  const buildModeButton=q('[data-build-mode]');
  function setBuildMode(enabled:boolean){
    buildMode=enabled;
    buildModeButton?.setAttribute('aria-pressed',String(enabled));
    if(buildModeButton) buildModeButton.textContent=enabled?'Exit build mode':'Build mode';

    if(enabled){
      usage('enter_build_mode');
      buildModeScrollY=window.scrollY;
      document.body.classList.add('vc-build-mode');
    }else{
      document.body.classList.remove('vc-build-mode');
    }

    requestAnimationFrame(()=>{
      resize();
      fit();
      if(!enabled) window.scrollTo({top:buildModeScrollY,behavior:'auto'});
    });
  }
  buildModeButton?.addEventListener('click',()=>setBuildMode(!buildMode));
  document.addEventListener('keydown',(event)=>{
    if(event.key==='Escape'&&buildMode&&!q<HTMLDialogElement>('[data-qr-dialog]').open)setBuildMode(false);
  });

  const num = (name:string, fallback:number) => Number(q<HTMLInputElement>(`[data-input="${name}"]`)?.value ?? fallback);
  const text = (name:string, fallback='') => String(q<HTMLInputElement>(`[data-input="${name}"]`)?.value ?? fallback);
  const setText = (sel:string, value:string|number) => { const el=q(sel); if(el) el.textContent=String(value); };
  const clamp = (n:number,min:number,max:number) => Math.max(min, Math.min(max, Math.round(Number.isFinite(n)?n:min)));

  function params():BlueprintState{
    const rawStyle=text('style','thin');
    const style=['thin','thick','filled'].includes(rawStyle)?rawStyle as BuildStyle:'thin';
    const rawThickness=clamp(num('thickness',1),1,32);
    const thickness=style==='thin'||style==='filled'?1:Math.max(2,rawThickness);
    if(shape==='circle') return {shape, diameter:clamp(num('diameter',31),3,512), style, thickness};
    if(shape==='oval') return {shape, width:clamp(num('width',31),3,512), height:clamp(num('height',21),3,512), style, thickness};
    return {shape, width:clamp(num('width',31),3,256), depth:clamp(num('depth',31),3,256), height:clamp(num('height',16),2,256), style, thickness};
  }
  function blueprintSlug(){
    const p=params();
    const style=p.style==='thick'?`thick-${p.thickness}`:p.style;
    if(p.shape==='circle') return `voxelcurve-circle-${p.diameter}-${style}`;
    if(p.shape==='oval') return `voxelcurve-oval-${p.width}x${p.height}-${style}`;
    return `voxelcurve-dome-${p.width}x${p.depth}x${p.height}-${style}`;
  }
  function makeResult(){
    const p=params();
    if(p.shape==='circle') return generateCircle(p.diameter,p.style,p.thickness);
    if(p.shape==='oval') return generateOval(p.width,p.height,p.style,p.thickness);
    return generateDome(p.width,p.depth,p.height,p.style,p.thickness);
  }
  function stateKey(){ const p=params(); return `vc-progress-v${result.geometryVersion}-${JSON.stringify(p)}`; }
  function pruneProgressStorage(limit=40){
    try{
      const items:{key:string;updatedAt:number}[]=[];
      const currentPrefix=`vc-progress-v${result.geometryVersion}-`;
      const keys=[];
      for(let i=0;i<localStorage.length;i++){
        const key=localStorage.key(i);
        if(key?.startsWith('vc-progress-v'))keys.push(key);
      }
      for(const key of keys){
        if(!key.startsWith(currentPrefix)){
          localStorage.removeItem(key);
          continue;
        }
        let updatedAt=0;
        try{updatedAt=Number(JSON.parse(localStorage.getItem(key)||'{}').updatedAt)||0}catch{}
        items.push({key,updatedAt});
      }
      items.sort((a,b)=>b.updatedAt-a.updatedAt);
      items.slice(limit).forEach(item=>localStorage.removeItem(item.key));
    }catch{}
  }
  function saveProgress(){
    try{
      if(!completed.size&&stepIndex===0){
        localStorage.removeItem(stateKey());
        setText('[data-save-status]','No saved progress for this blueprint · storage available.');
        return;
      }
      localStorage.setItem(stateKey(),encodeProgress(completed,steps,stepIndex));
      pruneProgressStorage();
      const step=steps[stepIndex];
      setText('[data-save-status]',`Saved on this device · ${shape==='dome'?`Layer ${step.layer+1} · `:''}Row ${step.row.y+1}.`);
    }catch{
      setText('[data-save-status]','Not saved · browser storage is unavailable. Keep this page open.');
      showStatus('Build progress could not be saved in this browser.','neutral');
    }
  }
  function loadProgress(){
    try{
      pruneProgressStorage();
      const raw=localStorage.getItem(stateKey());
      const restored=decodeProgress(raw,steps);
      completed=restored.completed;
      stepIndex=restored.stepIndex;
      const probe=`vc-storage-check-${Date.now()}-${Math.random()}`;
      localStorage.setItem(probe,'1');localStorage.removeItem(probe);
      const step=steps[stepIndex];
      setText('[data-save-status]',raw&&step&&(completed.size||stepIndex)?`Saved progress restored · ${shape==='dome'?`Layer ${step.layer+1} · `:''}Row ${step.row.y+1}.`:'Progress will be saved on this device.');
    }catch{
      setText('[data-save-status]','Not saved · browser storage is unavailable. Keep this page open.');
    }
  }

  function createSteps(){
    const out:Step[]=[];
    if(shape==='dome'){
      result.layers.forEach((layer,li)=>layer.rows.forEach((row)=>row.spans.forEach((span,si)=>out.push({key:`L${li}R${row.y}S${si}`,layer:li,row,span,si}))));
    } else result.rows.forEach(row=>row.spans.forEach((span,si)=>out.push({key:`R${row.y}S${si}`,layer:0,row,span,si})));
    return out;
  }
  function indexSteps(){
    stepsByLayer=new Map();
    stepsByRow=new Map();
    stepKeysByLayer=new Map();
    stepIndexByKey=new Map();
    steps.forEach((step,index)=>{
      stepIndexByKey.set(step.key,index);
      if(!stepsByLayer.has(step.layer))stepsByLayer.set(step.layer,[]);
      stepsByLayer.get(step.layer)!.push(step);
      const rowKey=`${step.layer}:${step.row.y}`;
      if(!stepsByRow.has(rowKey))stepsByRow.set(rowKey,[]);
      stepsByRow.get(rowKey)!.push(step);
      if(!stepKeysByLayer.has(step.layer))stepKeysByLayer.set(step.layer,new Map());
      stepKeysByLayer.get(step.layer)!.set(`${step.row.y}:${step.si}`,step.key);
    });
  }
  function activeRows(){ return shape==='dome' ? (result.layers[currentLayer]?.rows||[]) : result.rows; }

  function fit(){ zoom=1;panX=0;panY=0;draw(); }
  function resize(){ const r=wrap.getBoundingClientRect(); const dpr=Math.min(2,window.devicePixelRatio||1); canvas.width=Math.max(1,Math.round(r.width*dpr));canvas.height=Math.max(1,Math.round(r.height*dpr));canvas.style.width=`${r.width}px`;canvas.style.height=`${r.height}px`;ctx.setTransform(dpr,0,0,dpr,0,0);draw(); }

  function draw(){
    if(!result||!ctx) return;
    const rect=wrap.getBoundingClientRect(); const cw=rect.width,ch=rect.height;
    ctx.save();ctx.clearRect(0,0,cw,ch);ctx.fillStyle='#fcfcfc';ctx.fillRect(0,0,cw,ch);
    const rows=activeRows(); const gw=result.width; const gh=shape==='dome'?result.depth:result.height;
    const base=Math.max(.1,Math.min((cw-42)/gw,(ch-42)/gh)); const cell=base*zoom;
    const ox=(cw-gw*cell)/2+panX, oy=(ch-gh*cell)/2+panY;
    const current=steps[stepIndex];
    const layerIdx=shape==='dome'?currentLayer:0;
    const activeKeys=stepKeysByLayer.get(layerIdx)||new Map();
    if(current&&current.layer===layerIdx){ctx.fillStyle='#ecfdf5';ctx.fillRect(ox,oy+current.row.y*cell,gw*cell,cell)}
    if(display.grid&&cell>=5){ctx.strokeStyle='#eeeeee';ctx.lineWidth=1;for(let x=0;x<=gw;x++){ctx.beginPath();ctx.moveTo(ox+x*cell,oy);ctx.lineTo(ox+x*cell,oy+gh*cell);ctx.stroke()}for(let y=0;y<=gh;y++){ctx.beginPath();ctx.moveTo(ox,oy+y*cell);ctx.lineTo(ox+gw*cell,oy+y*cell);ctx.stroke()}}
    if(shape==='dome'&&display.ghost&&layerIdx>0){
      const ghostRows=result.layers[layerIdx-1]?.rows||[];
      ctx.save();ctx.globalAlpha=.2;ctx.fillStyle='#34d399';
      for(const row of ghostRows){
        for(const s of row.spans){
          if(cell<2.5){
            ctx.fillRect(ox+s.start*cell,oy+row.y*cell,Math.max(1,(s.end-s.start+1)*cell),Math.max(1,cell));
            continue;
          }
          const inset=Math.min(1,cell*.08);
          const size=Math.max(1,cell-Math.min(2,cell*.16));
          for(let x=s.start;x<=s.end;x++) ctx.fillRect(ox+x*cell+inset,oy+row.y*cell+inset,size,size);
        }
      }
      ctx.restore();
    }
    for(const row of rows){
      row.spans.forEach((s,si)=>{
        const key=activeKeys.get(`${row.y}:${si}`); const isDone=key&&completed.has(key); const isCurrent=current&&current.layer===layerIdx&&current.row.y===row.y&&current.si===si;
        if(cell<2.5){
          ctx.fillStyle=isCurrent?'#171717':isDone?'#a7f3d0':'#34d399';
          ctx.fillRect(ox+s.start*cell,oy+row.y*cell,(s.end-s.start+1)*cell,cell);
          return;
        }
        for(let x=s.start;x<=s.end;x++){
          ctx.fillStyle=isCurrent?'#171717':isDone?'#a7f3d0':'#34d399';
          ctx.fillRect(ox+x*cell+Math.min(1,cell*.08),oy+row.y*cell+Math.min(1,cell*.08),Math.max(1,cell-Math.min(2,cell*.16)),Math.max(1,cell-Math.min(2,cell*.16)));
        }
        if(display.segments&&cell>=13){ctx.fillStyle=isCurrent?'#ffffff':'#171717';ctx.font='10px system-ui';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(String(s.end-s.start+1),ox+(s.start+s.end+1)*cell/2,oy+(row.y+.5)*cell)}
      })
    }
    if(display.axis){ctx.strokeStyle='#f59e0b';ctx.lineWidth=1.5;ctx.setLineDash([5,5]);ctx.beginPath();ctx.moveTo(ox+gw*cell/2,oy);ctx.lineTo(ox+gw*cell/2,oy+gh*cell);ctx.moveTo(ox,oy+gh*cell/2);ctx.lineTo(ox+gw*cell,oy+gh*cell/2);ctx.stroke();ctx.setLineDash([])}
    if(display.center){ctx.fillStyle='#b45309';ctx.beginPath();ctx.arc(ox+gw*cell/2,oy+gh*cell/2,3,0,Math.PI*2);ctx.fill()}
    if(display.labels&&cell>=13){ctx.fillStyle='#65766c';ctx.font='10px system-ui';ctx.textAlign='right';ctx.textBaseline='middle';for(const row of rows){if(row.count)ctx.fillText(String(row.y+1),ox-5,oy+(row.y+.5)*cell)}}
    ctx.restore();
  }

  function renderInstruction(){
    if(!steps.length){setText('[data-instruction-title]','No blocks generated');setText('[data-instruction-body]','Try a different size.');return;}
    stepIndex=Math.max(0,Math.min(stepIndex,steps.length-1)); const s=steps[stepIndex]; currentLayer=s.layer;
    const inst=rowInstruction(s.row,result.width)[s.si];
    const rowTotal=shape==='dome'?result.depth:result.height;
    const title=`${shape==='dome'?`Layer ${result.layers[s.layer].index+1} / ${result.height} · `:''}Row ${s.row.y+1} / ${rowTotal} · Segment ${s.si+1} / ${s.row.spans.length}`;
    const gap= s.si<s.row.spans.length-1 ? s.row.spans[s.si+1].start-s.span.end-1 : 0;
    const primary=instructionMode==='edge'?inst.edge:inst.center;
    const body=`${primary}. ${gap>0?`Then skip ${gap} block${gap===1?'':'s'}.`:''}`;
    setText('[data-instruction-title]',title);setText('[data-instruction-body]',body);
    const done=completed.size;
    const built=steps.reduce((count,step)=>count+(completed.has(step.key)?step.span.end-step.span.start+1:0),0);
    const pct=result.blockCount?Math.round(built/result.blockCount*100):0;
    const remaining=result.blockCount-built;
    q('[data-progress-bar]').style.width=`${pct}%`;
    q('.progress').setAttribute('aria-valuenow',String(pct));
    setText('[data-progress-label]',`${pct}% complete · ${done}/${steps.length} segments`);
    setText('[data-remaining]',`Remaining: ${remaining.toLocaleString()} blocks · ${Math.floor(remaining/64)} stacks + ${remaining%64} loose`);
    const rowJump=q<HTMLInputElement>('[data-row-jump-input]');
    rowJump.max=String(rowTotal);rowJump.value=String(s.row.y+1);
    setText('[data-row-total]',rowTotal);
    const unfinished=q<HTMLButtonElement>('[data-unfinished]');
    unfinished.disabled=completed.size===steps.length;
    unfinished.textContent=unfinished.disabled?'All segments complete ✓':'Next unfinished segment';
    q<HTMLButtonElement>('[data-row-prev]').disabled=!steps.some(step=>step.layer===s.layer&&step.row.y<s.row.y);
    q<HTMLButtonElement>('[data-row-next]').disabled=!steps.some(step=>step.layer===s.layer&&step.row.y>s.row.y);
    q<HTMLButtonElement>('[data-prev]').disabled=stepIndex===0;
    q<HTMLButtonElement>('[data-next]').disabled=stepIndex===steps.length-1;
    if(shape==='dome'){
      setText('[data-layer]',`${currentLayer+1}/${result.layers.length}`);
      setText('[data-layer-blocks]',result.layers[currentLayer]?.count||0);
      const layerSteps=stepsByLayer.get(currentLayer)||[];
      const layerDone=layerSteps.filter(step=>completed.has(step.key)).length;
      const layerBuilt=layerSteps.reduce((count,step)=>count+(completed.has(step.key)?step.span.end-step.span.start+1:0),0);
      const layerPct=Math.round(layerBuilt/result.layers[currentLayer].count*100);
      setText('[data-layer-progress]',`Layer ${currentLayer+1}: ${layerPct}% · ${layerDone}/${layerSteps.length} segments`);
      const currentCount=result.layers[currentLayer]?.count||0;
      const previousCount=currentLayer>0?(result.layers[currentLayer-1]?.count||0):null;
      let deltaText=previousCount===null?'Base layer':`Layer total: ${currentCount-previousCount>=0?'+':''}${currentCount-previousCount} blocks`;
      if(currentLayer>0){
        const prevRow=result.layers[currentLayer-1]?.rows.find(row=>row.y===s.row.y);
        if(prevRow?.spans.length&&s.row.spans.length){
          const currentLeft=Math.min(...s.row.spans.map(span=>span.start));
          const currentRight=Math.max(...s.row.spans.map(span=>span.end));
          const previousLeft=Math.min(...prevRow.spans.map(span=>span.start));
          const previousRight=Math.max(...prevRow.spans.map(span=>span.end));
          const left=currentLeft-previousLeft;
          const right=currentRight-previousRight;
          deltaText=`Row delta · left ${left>=0?'+':''}${left} · right ${right>=0?'+':''}${right}`;
        }
      }
      setText('[data-layer-delta]',deltaText);
      const prevLayerBtn=q<HTMLButtonElement>('[data-layer-prev]'),nextLayerBtn=q<HTMLButtonElement>('[data-layer-next]');
      if(prevLayerBtn) prevLayerBtn.disabled=currentLayer===0;
      if(nextLayerBtn) nextLayerBtn.disabled=currentLayer===result.layers.length-1;
      const jump=q<HTMLInputElement>('[data-layer-jump-input]');
      if(jump){jump.max=String(result.layers.length);jump.value=String(currentLayer+1)}
      setText('[data-layer-total]',result.layers.length);
    }
    const volume=result.type==='dome'?result.width*result.depth*result.height:result.width*result.height;
    const blocked=volume>20_000_000||result.blockCount>5_000_000;
    const large=volume>10_000_000||result.blockCount>2_000_000;
    const minDim=result.type==='dome'?Math.min(result.width,result.depth,result.height):Math.min(result.width,result.height);
    const filledByThickness=result.style==='thick'&&result.thickness>=Math.max(1,Math.floor(minDim/2));
    const litematic=q<HTMLButtonElement>('[data-litematic]');
    if(litematic){
      litematic.disabled=blocked||exporting;
      litematic.title=blocked?'Reduce dimensions before exporting Litematic.':'Download Litematic for supported Java Edition workflows.';
    }
    const warning=q('[data-size-warning]');
    if(warning){
      const messages=[];
      if(filledByThickness) messages.push('Thickness reaches the center, so this build is effectively filled while keeping the same outside dimensions.');
      if(blocked) messages.push('This structure is too large for safe browser Litematic export. Reduce its dimensions or use a hollow build.');
      else if(large) messages.push('Large structure: exports may take longer on mobile devices.');
      warning.hidden=messages.length===0;
      warning.textContent=messages.join(' ');
    }
    q<HTMLButtonElement>('[data-complete]').textContent=completed.has(s.key)?'Completed ✓':'Complete segment';
    draw();
  }

  function renderStats(){setText('[data-blocks]',result.blockCount.toLocaleString()); const stacks=Math.floor(result.blockCount/64),loose=result.blockCount%64;setText('[data-stacks]',loose?`${stacks} + ${loose}`:String(stacks)); const p=params();setText('[data-blueprint-title]',p.shape==='circle'?`${p.diameter}×${p.diameter} Circle`:p.shape==='oval'?`${p.width}×${p.height} Oval`:`${p.width}×${p.depth}×${p.height} Dome`)}

